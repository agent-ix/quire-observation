{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:agent-ix:quire-observation:partial-fact:1",
  "title": "Observation partial fact owner artifact v1", "type": "object", "additionalProperties": false,
  "required": ["contract", "identity", "revision", "authority", "subject", "payload", "predecessor", "limits"],
  "properties": {
    "contract": {"const": "quire.observation.partial-fact/v1"}, "identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "revision": {"type": "integer", "minimum": 1}, "authority": {"$ref": "observation-record-v1.schema.json#/$defs/authority"}, "subject": {"$ref": "observation-record-v1.schema.json#/$defs/subject"},
    "payload": {"type": "object", "additionalProperties": false, "required": ["observation_identity", "possibilities", "interval", "ingestion_position"], "properties": {
      "observation_identity": {"type": "string", "minLength": 1},
      "possibilities": {"oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["can_be_false", "can_be_true", "reason"], "properties": {"can_be_false": {"const": false}, "can_be_true": {"const": true}, "reason": {"const": "known"}}},
        {"type": "object", "additionalProperties": false, "required": ["can_be_false", "can_be_true", "reason"], "properties": {"can_be_false": {"const": true}, "can_be_true": {"const": false}, "reason": {"const": "known"}}},
        {"type": "object", "additionalProperties": false, "required": ["can_be_false", "can_be_true", "reason"], "properties": {"can_be_false": {"const": true}, "can_be_true": {"const": true}, "reason": {"const": "missing"}}},
        {"type": "object", "additionalProperties": false, "required": ["can_be_false", "can_be_true", "reason"], "properties": {"can_be_false": {"const": true}, "can_be_true": {"const": true}, "reason": {"const": "conflicting"}}}
      ]},
      "interval": {"type": "object", "additionalProperties": false, "required": ["clock_identity", "clock_revision", "unit", "earliest", "latest"], "properties": {"clock_identity": {"type": "string", "minLength": 1}, "clock_revision": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "earliest": {"$ref": "observation-record-v1.schema.json#/$defs/integerText"}, "latest": {"$ref": "observation-record-v1.schema.json#/$defs/integerText"}}},
      "ingestion_position": {"$ref": "observation-record-v1.schema.json#/$defs/integerText"}
    }},
    "predecessor": {"$ref": "observation-record-v1.schema.json#/$defs/predecessor"}, "limits": {"$ref": "observation-record-v1.schema.json#/$defs/limits"}
  }
}
