{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:agent-ix:quire-observation:completeness-assertion:1",
  "title": "Observation completeness assertion owner artifact v1", "type": "object", "additionalProperties": false,
  "required": ["contract", "identity", "revision", "authority", "subject", "payload", "predecessor", "limits"],
  "properties": {
    "contract": {"const": "quire.observation.completeness-assertion/v1"}, "identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "revision": {"type": "integer", "minimum": 1}, "authority": {"$ref": "observation-record-v1.schema.json#/$defs/authority"}, "subject": {"$ref": "observation-record-v1.schema.json#/$defs/subject"},
    "payload": {"type": "object", "additionalProperties": false, "required": ["population_identity", "boundary_identity", "facts", "state"], "properties": {"population_identity": {"type": "string", "minLength": 1}, "boundary_identity": {"type": "string", "minLength": 1}, "facts": {"type": "array", "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["member_identity", "observation_identity", "status"], "properties": {"member_identity": {"type": "string", "minLength": 1}, "observation_identity": {"type": ["string", "null"]}, "status": {"enum": ["available", "incomplete", "contradicted"]}}}}, "state": {"enum": ["complete", "incomplete", "contradicted"]}}},
    "predecessor": {"$ref": "observation-record-v1.schema.json#/$defs/predecessor"}, "limits": {"$ref": "observation-record-v1.schema.json#/$defs/limits"}
  }
}
